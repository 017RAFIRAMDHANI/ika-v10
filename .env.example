# Salin menjadi .env.local lalu isi. JANGAN commit .env.local atau secret asli.
# Buat secret acak: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
SESSION_SECRET=ganti-dengan-minimal-32-karakter-acak
FACE_DATA_SECRET=ganti-dengan-minimal-32-karakter-acak
REGISTRATION_PRIMARY_CODE=GANTI-KODE-PENDAFTARAN
FACE_MATCH_THRESHOLD=0.68
FACE_ARCFACE_MATCH_THRESHOLD=0.42
FACE_CROSS_DEVICE_ENABLED=true

# Opsional, hanya untuk scripts/backup-v9.mjs dan scripts/migrasi-dari-v9.mjs:
# V9_DATABASE_URL=postgresql://USER:PASSWORD@HOST-V9/neondb?sslmode=require
# V9_FACE_DATA_SECRET=secret-wajah-milik-v9
